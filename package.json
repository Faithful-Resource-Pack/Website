{
	"name": "faithful-website",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"start": "node .output/server/index.mjs",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"prettier": "prettier \"{,!(node_modules)/**/}*.{js,vue,html,ts}\" --write",
		"docker:build": "docker build --tag faithful-website .",
		"docker:start": "docker run -d -p 3000:3000 faithful-website",
		"docker:alive": "curl -s -o /dev/null -w \"%{http_code} %{content_type}\" http://localhost:3000 | grep -q \"^200 text/html\""
	},
	"dependencies": {
		"isomorphic-dompurify": "^4.5.0",
		"luxon": "^3.7.2",
		"marked": "^18.1.0",
		"nuxt": "^4.6.0",
		"remove-markdown": "^0.8.0",
		"sass": "^1.105.1",
		"vue": "^3.5.43",
		"vuetify-nuxt-module": "^0.19.5",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@nuxt/eslint": "1.17.0",
		"@types/luxon": "^3.7.6",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9"
	},
	"peerDependencies": {
		"vuetify": "3"
	}
}
